# Application
NODE_ENV=development
PORT=5000

# Frontend origins (comma-separated for multiple)
# Example: http://localhost:5173,https://app.example.com
CLIENT_URL=http://localhost:5173

# Socket.IO uses the same HTTP server and CLIENT_URL allowlist for CORS.
# No separate SOCKET_PORT is required.

# MongoDB
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/campus-connect

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Access token
JWT_ACCESS_SECRET=replace_with_a_long_random_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# Email — Gmail SMTP (use a Google App Password, not your normal Gmail password)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_16_char_app_password_no_spaces
EMAIL_FROM_ADDRESS=your_gmail@gmail.com
EMAIL_FROM_NAME=CampusConnect
EMAIL_VERIFICATION_TOKEN_EXPIRES_MINUTES=60

# Contact form — admin inbox (defaults to mansiraghuvanshi2006@gmail.com)
CONTACT_ADMIN_EMAIL=mansiraghuvanshi2006@gmail.com
# Rate limit for public contact form (per IP). Dev defaults to 100 / 15 min.
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# WebRTC ICE configuration (returned only to authenticated call participants)
# Comma-separated STUN URLs. Defaults to public Google STUN servers when unset.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay for restrictive networks / production.
# Leave blank in local development unless you operate a TURN server.
# Never commit real TURN credentials.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Campus AI (Gemini) — optional; AI routes return a clear
# "not configured" response when GEMINI_API_KEY is empty.
# Never commit real API keys.
GEMINI_API_KEY=
# Default: gemini-flash-latest (works on free tier; switch in Campus AI UI)
GEMINI_MODEL=gemini-flash-latest
GEMINI_SEARCH_MODEL=gemini-flash-latest
# Comma-separated models users can pick in Campus AI (same API key / project)
GEMINI_ALLOWED_MODELS=gemini-flash-latest,gemini-3-flash-preview,gemini-3.5-flash
AI_MAX_PROMPT_LENGTH=8000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
AI_AUTOCOMPLETE_RATE_LIMIT_MAX=30
AI_MUTATION_RATE_LIMIT_MAX=60
AI_MAX_HISTORY_MESSAGES=30
AI_MAX_TOOL_CALLS=5
AI_TOOL_AUDIT_RETENTION_DAYS=180
