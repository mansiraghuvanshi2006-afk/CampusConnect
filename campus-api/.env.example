# Application
NODE_ENV=development
PORT=5000

# Frontend
CLIENT_URL=http://localhost:5173

# Socket.IO uses the same HTTP server and CLIENT_URL for CORS.
# No separate SOCKET_PORT is required.

# MongoDB
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/campus-connect

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Access token
JWT_ACCESS_SECRET=replace_with_a_long_random_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d